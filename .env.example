# ──────────────────────────────────────────────────────────────
# Replang — variables d'environnement (exemple)
# Copie ce fichier en `.env` et adapte les valeurs.
# Ne JAMAIS committer le vrai .env.
# ──────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=replang
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=replang
POSTGRES_PORT=5432
# URL consommée par Prisma dans les services (réseau Docker : host = "postgres")
DATABASE_URL=postgresql://replang:changeme_dev_password@postgres:5432/replang?schema=public

# ─── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ─── MinIO / S3 ───────────────────────────────────────────────
MINIO_ROOT_USER=replang
MINIO_ROOT_PASSWORD=changeme_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=replang-audio
S3_ACCESS_KEY=replang
S3_SECRET_KEY=changeme_dev_password
# true en local (MinIO), false avec un vrai S3 AWS
S3_FORCE_PATH_STYLE=true

# ─── Ollama (IA) ──────────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# ─── Auth (Better-Auth) ───────────────────────────────────────
# Secret de signature — générer avec: openssl rand -hex 32
BETTER_AUTH_SECRET=changeme_generate_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3001
# Origines autorisées (frontend), séparées par des virgules
TRUSTED_ORIGINS=http://localhost:3000

# ─── APIs externes (Dict / Translate) ─────────────────────────
FREE_DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost
NODE_ENV=development

# ─── Ports des services applicatifs (dev) ─────────────────────
AUTH_PORT=3001
NOTES_PORT=3002
AUDIO_PORT=3003
CARDS_PORT=3004
DICT_PORT=3005
NOTIF_PORT=3006
AI_PORT=8000
FRONTEND_PORT=3000

# ─── GitHub Packages (pour installer @replang/db et @replang/shared) ──
# Utilisé en CI/Docker pour s'authentifier au registre npm privé.
# NPM_TOKEN=ghp_xxx
